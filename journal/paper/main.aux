\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Fixed deployment feature-erasure probability $p_{\rm  ch}=0.5$ and varying training probability, with $n=800$, $d=16$, and $m=100$. Perfect training is the point $p_{\rm  tr}=0$; its data-only PAC objective is common to the proposed perfect-channel specialization. Means and one sample standard deviation use all three listed seeds. The vertical line marks matched training.}}{3}{}\protected@file@percent }
\newlabel{fig:sim_training_mismatch}{{2}{3}{}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Unweighted bound terms and signed observed gaps for perfect, matched, and mismatched training, at the same deployment law $p_{\rm  ch}=0.5$, $n=800$, $d=16$, and $m=100$. Each column evaluates the frozen posterior learned under its stated training law. Stacked theoretical terms are those of T1; markers evaluate T2 at the same posterior. The per-run nominal failure budget is $0.05$. Shift uses the bounded-loss total-variation specialization. These illustrative gap estimates do not include the additional MC correction used in Table~\ref {tab:sim_certificate}.}}{3}{}\protected@file@percent }
