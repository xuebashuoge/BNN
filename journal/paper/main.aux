\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Deployment performance under matched Gaussian fading and additive noise. Accuracy is in percent; bounded risk uses the smooth loss in~\eqref  {equ:sim_bounded_loss}. Entries are mean $\pm $ sample standard deviation over three initialization/channel-bank seeds for MNIST and two for FashionMNIST, with ten fresh Gibbs/channel draws per checkpoint. Perfect refers to training only; all models face the same deployment law. Bold identifies the best reported mean within each metric.}}{3}{}\protected@file@percent }
\newlabel{tab:sim_accuracy_risk}{{II}{3}{}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Effect of the reusable channel-bank size under matched feature erasures: $p_{\rm  tr}=p_{\rm  ch}=0.5$, $n=512$, and $d=8$. Curves show means over three initialization/channel-bank seeds; shading shows one sample standard deviation and points retain individual seeds. The data, number of optimizer updates, and deployment law are fixed across $m$. Perfect-trained references are reused across bank sizes. The right panel isolates the observed channel generalization gap in normalized-loss units.}}{3}{}\protected@file@percent }
\newlabel{fig:sim_channel_bank}{{1}{3}{}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces CIFAR-10 deployment performance under Gaussian fading and additive noise. Entries are mean $\pm $ sample standard deviation across initialization/channel-bank seeds conditional on the fixed data split, using ten fresh Gibbs/channel draws per checkpoint. Full data: $n=45,000$, 100 epochs, 3 paired seeds. Configurations use aggregate validation accuracy; checkpoints use validation accuracy. Perfect refers to the training forward channel only. Bold marks the best mean within each metric.}}{3}{}\protected@file@percent }
\newlabel{tab:sim_cifar}{{III}{3}{}{table.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {V-E}}Bound Decomposition and Numerical Risk Guarantees}{3}{}\protected@file@percent }
\newlabel{sec:sim_bounds}{{\mbox  {V-E}}{3}{}{subsection.5.5}{}}
\newlabel{equ:sim_signed_decomposition}{{3}{3}{}{equation.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Fixed deployment feature-erasure probability $p_{\rm  ch}=0.5$ and varying training probability, with $n=800$, $d=16$, and $m=100$. Perfect training is the point $p_{\rm  tr}=0$; its data-only PAC objective is common to the proposed perfect-channel specialization. Means and one sample standard deviation use all three listed seeds. The vertical line marks matched training.}}{4}{}\protected@file@percent }
\newlabel{fig:sim_training_mismatch}{{2}{4}{}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Unweighted bound terms and signed observed gaps for perfect, matched, and mismatched training, at the same deployment law $p_{\rm  ch}=0.5$, $n=800$, $d=16$, and $m=100$. Each column evaluates the frozen posterior learned under its stated training law. Stacked theoretical terms are those of T1; markers evaluate T2 at the same posterior. The per-run nominal failure budget is $0.05$. Shift uses the bounded-loss total-variation specialization. These illustrative gap estimates do not include the additional MC correction used in Table~\ref {tab:sim_certificate}.}}{4}{}\protected@file@percent }
\newlabel{fig:sim_bound_decomposition}{{3}{4}{}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Two population-risk bounds evaluated at the same frozen T1-trained posterior ($d=8$, $n=512$, $m=2000$). A fresh 100-draw empirical-risk estimate is shared by both bounds. The total failure budget is $0.05$: $0.04$ is split across both theorems and 21 declared setups, and $0.01$ controls Monte Carlo error. Values concern normalized bounded loss, not classification error.}}{4}{}\protected@file@percent }
\newlabel{tab:sim_certificate}{{IV}{4}{}{table.4}{}}
